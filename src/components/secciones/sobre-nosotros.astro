---
// Sobre nosotros: imagen + texto en párrafos + lista de compromisos.
import { seccion, parrafos } from '../../data/site';
import { altSeccion } from '../../lib/seo';
import Seccion from '../ui/Seccion.astro';
import Imagen from '../ui/Imagen.astro';
import Icono from '../ui/Icono.astro';
interface Props { id: string }
const s = seccion(Astro.props.id);
---

{
  s && (
    <Seccion id={Astro.props.id} class="bg-primario/[0.04]">
      <div class="grid items-start gap-12 md:grid-cols-2 md:gap-16">
        <Imagen src={s.imagen} alt={altSeccion(s)} ancho={1000} alto={1200} class="aspect-[5/6] w-full object-cover" />
        <div>
          {s.antetitulo && <p class="antetitulo">{s.antetitulo}</p>}
          <h2 class="titulo-seccion">{s.titulo}</h2>
          <div class="mt-6 space-y-4 opacity-85">
            {parrafos(s.texto).map((p) => <p>{p}</p>)}
          </div>
          {s.items.length > 0 && (
            <ul class="mt-8 divide-y divide-texto/10 border-y border-texto/10">
              {s.items.map((it) => (
                <li class="flex gap-4 py-4">
                  <Icono nombre={it.icono} class="mt-1 shrink-0 text-acento" tam={20} />
                  <div>
                    <p class="font-semibold text-primario">{it.titulo}</p>
                    {it.texto && <p class="text-sm opacity-75">{it.texto}</p>}
                  </div>
                </li>
              ))}
            </ul>
          )}
        </div>
      </div>
    </Seccion>
  )
}
