---
// Equipo: retratos en blanco y negro, nombre con serifa y cargo en versalitas.
import { seccion } from '../../data/site';
import Seccion from '../ui/Seccion.astro';
import Titular from '../ui/Titular.astro';
import Imagen from '../ui/Imagen.astro';
interface Props { id: string }
const s = seccion(Astro.props.id);
---

{
  s && (
    <Seccion id={Astro.props.id}>
      <Titular antetitulo={s.antetitulo} titulo={s.titulo} texto={s.texto} />
      <ul class="grid gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-4">
        {s.personas.map((p) => (
          <li>
            <Imagen src={p.foto} alt={p.nombre} ancho={600} alto={720} class="aspect-[5/6] w-full object-cover grayscale" />
            <p class="mt-5 font-display text-xl text-primario">{p.nombre}</p>
            {p.cargo && <p class="mt-1 text-xs font-semibold uppercase tracking-[.18em] text-acento">{p.cargo}</p>}
            {p.texto && <p class="mt-3 text-sm opacity-75">{p.texto}</p>}
          </li>
        ))}
      </ul>
    </Seccion>
  )
}
