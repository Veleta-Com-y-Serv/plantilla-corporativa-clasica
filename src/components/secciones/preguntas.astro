---
// Preguntas frecuentes: acordeón nativo <details>, sin JavaScript. Titular a la izquierda y preguntas con
// filete superior a la derecha, como los servicios. Campos: `preguntas[]` (pregunta, respuesta).
// Sin preguntas no se pinta. También sirve de diseño para apartados nuevos (`tipo: preguntas`).
import { seccion } from '../../data/site';
import Seccion from '../ui/Seccion.astro';
import Titular from '../ui/Titular.astro';
interface Props { id: string }
const s = seccion(Astro.props.id);
const preguntas = s ? s.preguntas.filter((p) => p && p.pregunta) : [];
---

{
  s && preguntas.length > 0 && (
    <Seccion id={Astro.props.id}>
      <div class="grid gap-10 md:grid-cols-12">
        <Titular class="md:col-span-4" antetitulo={s.antetitulo} titulo={s.titulo} texto={s.texto} />
        <div class="border-b border-primario/25 md:col-span-8">
          {preguntas.map((p, i) => (
            <details class="faq border-t border-primario/25">
              <summary class="flex items-baseline gap-5 py-6">
                <span class="font-display text-lg text-acento" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <span class="flex-1 font-display text-xl text-primario">{p.pregunta}</span>
                <span class="faq-signo text-2xl leading-none text-acento" aria-hidden="true">+</span>
              </summary>
              {p.respuesta && <p class="pb-6 pl-11 pr-8 opacity-80">{p.respuesta}</p>}
            </details>
          ))}
        </div>
      </div>
    </Seccion>
  )
}

<style>
  .faq summary { list-style: none; cursor: pointer; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq-signo { transition: transform 0.2s ease; }
  .faq[open] .faq-signo { transform: rotate(45deg); }
</style>
