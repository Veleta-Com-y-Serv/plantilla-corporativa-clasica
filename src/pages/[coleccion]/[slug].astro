---
// Ficha de un elemento con `detalle` (src/lib/paginas.ts, listas de src/data/fichas.ts): /servicios/<slug>/.
// Diseño clásico: migas y cabecera con serifa, filete dorado y esquinas rectas; foto a la derecha (o, sin foto,
// el icono en un recuadro con filete); cuerpo con el detalle y, al lado, tabla de datos y recuadro de contacto en
// azul de la marca; galería y otros servicios en una banda tenue con filetes finos.
import Base from '../../layouts/Base.astro';
import Imagen from '../../components/ui/Imagen.astro';
import Icono from '../../components/ui/Icono.astro';
import Titular from '../../components/ui/Titular.astro';
import { site, tel, whatsapp } from '../../data/site';
import { fichas, relacionadas, resumen } from '../../lib/paginas';
import type { Ficha } from '../../lib/paginas';
import { altGaleria, jsonLdFicha, jsonLdMigas, urlBase } from '../../lib/seo';
import { enlace, rutaDeSeccion } from '../../lib/multipagina';

export function getStaticPaths() {
  return fichas().map((f) => ({ params: { coleccion: f.def.ruta, slug: f.slug }, props: { f } }));
}

interface Props { f: Ficha }
const { f } = Astro.props;
const base = urlBase(Astro.site);
const nombreSeccion = String(f.seccion.antetitulo || f.seccion.titulo || f.def.nombre).trim();
const migas = [
  { nombre: 'Inicio', ruta: '/' },
  { nombre: nombreSeccion, ruta: rutaDeSeccion(f.idSeccion) },
  { nombre: f.titulo, ruta: f.url },
];
const c = site.contacto;
const contacto = site.boton_cabecera?.url || enlace('/#contacto');
const textoContacto = site.boton_cabecera?.texto || 'Pide cita';
const wa = whatsapp(c.whatsapp, `Hola, quiero información sobre ${f.titulo}`);
const datos = f.datos.filter((d) => d.clave !== 'precio');
const otras = relacionadas(f, 3);
const descripcion = resumen(f.texto || f.detalle[0] || '');
---

<Base titulo={f.titulo} descripcion={descripcion} imagen={f.imagen} ld={[jsonLdMigas(base, migas), jsonLdFicha(base, f)]}>
  <section class="ficha-cabeza">
    <div class="contenedor">
      <nav aria-label="Migas de pan" class="migas">
        <ol>
          {migas.map((m, i) => (
            <li>{i < migas.length - 1 ? <a href={m.ruta}>{m.nombre}</a> : <span aria-current="page">{m.nombre}</span>}</li>
          ))}
        </ol>
      </nav>
      <div class:list={['ficha-hero', { 'ficha-hero--sin-foto': !f.imagen }]}>
        <div class="ficha-hero-texto">
          <p class="antetitulo">{f.categoria || f.def.nombre}</p>
          <h1 class="titulo-seccion">{f.titulo}</h1>
          {f.texto && <p class="titular-texto">{f.texto}</p>}
          {f.precio && <p class="ficha-precio">{f.precio}</p>}
          <div class="ficha-botones">
            <a class="btn" href={contacto}>{textoContacto}</a>
            {wa && <a class="btn-sec" href={wa} target="_blank" rel="noopener"><Icono nombre="mensaje" tam={18} /> WhatsApp</a>}
          </div>
        </div>
        {f.imagen ? (
          <div class="ficha-foto">
            <Imagen src={f.imagen} alt={f.titulo} ancho={1200} alto={900} prioridad class="h-full w-full object-cover" />
          </div>
        ) : (
          <div class="ficha-icono" aria-hidden="true"><Icono nombre={f.icono || 'balanza'} tam={88} /></div>
        )}
      </div>
    </div>
  </section>

  <section class="ficha-cuerpo-banda">
    <div class="contenedor ficha-cuerpo">
      <article class="ficha-detalle">
        {f.detalle.map((p) => <p>{p}</p>)}
      </article>
      <aside class="ficha-lado">
        {(datos.length > 0 || f.precio) && (
          <div class="ficha-datos">
            <h2 class="ficha-lado-titulo">En pocas palabras</h2>
            <dl>
              {f.precio && <div><dt>Precio</dt><dd>{f.precio}</dd></div>}
              {datos.map((d) => <div><dt>{d.etiqueta}</dt><dd>{d.valor}</dd></div>)}
            </dl>
          </div>
        )}
        <div class="ficha-cita">
          <p class="ficha-cita-titulo">Hablemos de tu caso</p>
          <p>Te explicamos cómo lo llevaríamos y lo dejamos por escrito antes de empezar.</p>
          <a class="btn ficha-cita-btn" href={contacto}>{textoContacto}</a>
          {c.telefono && <a class="ficha-tel" href={tel(c.telefono)}><Icono nombre="telefono" tam={18} /> {c.telefono}</a>}
        </div>
      </aside>
    </div>
  </section>

  {f.imagenes.length > 0 && (
    <section class="ficha-galeria-banda" aria-label={`Fotos de ${f.titulo}`}>
      <div class="contenedor">
        <ul class="ficha-galeria">
          {f.imagenes.map((src, i) => (
            <li><Imagen src={src} alt={`${f.titulo}: ${altGaleria(i).toLowerCase()}`} ancho={800} alto={600} class="h-full w-full object-cover" /></li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {otras.length > 0 && (
    <section class="seccion">
      <div class="contenedor">
        <Titular antetitulo={nombreSeccion} titulo="Otros servicios" />
        <ul class="ficha-otras">
          {otras.map((o) => (
            <li class="ficha-otra">
              <Icono nombre={o.icono || 'balanza'} class="ficha-otra-icono" />
              <h3><a href={o.url} class="ficha-otra-enlace">{o.titulo}</a></h3>
              {o.texto && <p>{o.texto}</p>}
              <p class="ficha-otra-pie">
                {o.precio && <span class="ficha-precio">{o.precio}</span>}
                <span class="ficha-otra-ver" aria-hidden="true">Ver más <Icono nombre="flecha" tam={16} /></span>
              </p>
            </li>
          ))}
        </ul>
        <p class="mt-10"><a class="btn-sec ficha-todos" href={rutaDeSeccion(f.idSeccion)}>Ver todos los servicios</a></p>
      </div>
    </section>
  )}
</Base>

<style>
  .ficha-cabeza { padding-block: clamp(1.25rem, 3vw, 2.25rem) clamp(3rem, 6vw, 5rem); border-bottom: 1px solid color-mix(in srgb, var(--c-texto) 12%, transparent); }
  .migas ol { display: flex; flex-wrap: wrap; gap: .25rem .5rem; font-size: .8rem; letter-spacing: .06em; text-transform: uppercase; }
  .migas li { display: inline-flex; align-items: center; gap: .5rem; min-width: 0; }
  .migas li + li::before { content: "/"; color: var(--c-acento); }
  .migas a { color: var(--c-primario); text-decoration: none; min-height: 2.75rem; display: inline-flex; align-items: center; }
  .migas a:hover { color: var(--c-acento); }
  .migas [aria-current] { opacity: .7; overflow-wrap: anywhere; }
  .ficha-hero { display: grid; gap: 2.5rem; margin-top: clamp(.5rem, 2vw, 1.5rem); align-items: center; }
  .ficha-hero-texto .titulo-seccion { font-size: clamp(2.2rem, 6vw, 3.8rem); overflow-wrap: anywhere; }
  .ficha-precio { margin-top: 1.4rem; font-family: var(--fuente-titulos); font-size: 1.35rem; color: var(--c-acento); }
  .ficha-botones { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 2rem; }
  .ficha-botones .btn-sec { color: var(--c-primario); }
  .ficha-foto { aspect-ratio: 4 / 3; overflow: hidden; border: 1px solid color-mix(in srgb, var(--c-primario) 25%, transparent); padding: .6rem; background: var(--c-fondo); }
  .ficha-foto :global(img) { display: block; }
  .ficha-icono { display: grid; place-items: center; aspect-ratio: 4 / 3; border: 1px solid color-mix(in srgb, var(--c-primario) 30%, transparent); color: var(--c-primario); background: color-mix(in srgb, var(--c-primario) 4%, var(--c-fondo)); }
  .ficha-cuerpo-banda { padding-block: var(--ritmo); }
  .ficha-cuerpo { display: grid; gap: 3rem; }
  .ficha-detalle { max-width: 44rem; font-size: 1.1rem; }
  .ficha-detalle p + p { margin-top: 1.2rem; }
  .ficha-detalle p:first-child { font-family: var(--fuente-titulos); font-size: 1.3rem; line-height: 1.5; color: var(--c-primario); }
  .ficha-lado { display: grid; gap: 1.5rem; align-content: start; }
  .ficha-lado-titulo { font-size: 1.25rem; margin-bottom: .75rem; color: var(--c-primario); }
  .ficha-datos { border-top: 2px solid var(--c-acento); padding-top: 1.25rem; }
  .ficha-datos dl > div { display: flex; justify-content: space-between; gap: 1rem; padding: .8rem 0; border-top: 1px solid color-mix(in srgb, var(--c-texto) 14%, transparent); }
  .ficha-datos dt { font-size: .8rem; letter-spacing: .1em; text-transform: uppercase; opacity: .7; }
  .ficha-datos dd { text-align: right; min-width: 0; overflow-wrap: anywhere; }
  .ficha-cita { display: grid; gap: .9rem; padding: 1.75rem 1.5rem; background: var(--c-primario); color: #f4f1ea; }
  .ficha-cita-titulo { font-family: var(--fuente-titulos); font-size: 1.5rem; line-height: 1.2; }
  .ficha-cita-btn { background: var(--c-acento); border-color: var(--c-acento); color: #fff; justify-self: start; }
  .ficha-cita-btn:hover { background: color-mix(in srgb, var(--c-acento) 85%, #000); }
  .ficha-tel { display: inline-flex; align-items: center; gap: .5rem; min-height: 2.75rem; color: #fff; text-decoration: none; }
  .ficha-galeria-banda { padding-block: var(--ritmo); background: color-mix(in srgb, var(--c-primario) 5%, var(--c-fondo)); border-block: 1px solid color-mix(in srgb, var(--c-texto) 10%, transparent); }
  .ficha-galeria { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr)); }
  .ficha-galeria li { aspect-ratio: 4 / 3; overflow: hidden; }
  .ficha-otras { display: grid; gap: 2.5rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr)); }
  .ficha-otra { position: relative; display: flex; flex-direction: column; gap: .7rem; border-top: 1px solid color-mix(in srgb, var(--c-primario) 25%, transparent); padding-top: 1.5rem; }
  .ficha-otra :global(.ficha-otra-icono) { color: color-mix(in srgb, var(--c-primario) 60%, transparent); }
  .ficha-otra h3 { font-size: 1.3rem; color: var(--c-primario); }
  .ficha-otra-enlace { text-decoration: none; color: inherit; }
  .ficha-otra-enlace::after { content: ""; position: absolute; inset: 0; }
  .ficha-otra-enlace:focus-visible { outline: none; }
  .ficha-otra:has(.ficha-otra-enlace:focus-visible) { outline: 2px solid var(--c-acento); outline-offset: 4px; }
  .ficha-otra p { opacity: .8; }
  .ficha-otra-pie { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-top: auto; padding-top: .5rem; opacity: 1 !important; }
  .ficha-otra-pie .ficha-precio { margin-top: 0; font-size: 1.1rem; }
  .ficha-otra-ver { display: inline-flex; align-items: center; gap: .3rem; font-size: .85rem; letter-spacing: .06em; text-transform: uppercase; color: var(--c-acento); }
  .ficha-todos { color: var(--c-primario); }
  @media (min-width: 1024px) {
    .ficha-hero { grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); gap: 4rem; }
    .ficha-cuerpo { grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr); gap: 5rem; align-items: start; }
    .ficha-lado { position: sticky; top: 6.5rem; }
    .ficha-cuerpo-banda { padding-block: var(--ritmo-md); }
    .ficha-galeria-banda { padding-block: var(--ritmo-md); }
  }
</style>